{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "rootDir": "..",
    "outDir": "./dist",
    "baseUrl": "..",
    "paths": {
      "@/*": [
        "src/*"
      ]
    },
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": false
  },
  "include": [
    "src/**/*.ts",
    "../src/lib/**/*.ts"
  ],
  "exclude": [
    "../node_modules",
    "./dist"
  ]
}
