
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // url      = env("DATABASE_URL")
}

// User-requested custom models for custom Org Roles
// Note: We use stringified arrays for feature permissions here.

model Role {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String // Role name (e.g. 'Moderator', 'Billing')
  permissions    String // JSON string of feature flags for this role
  createdAt      DateTime @default(now())

  // We map it to members via application logic or relations, but for now Better Auth org plugin stores `role: string` on Member.
  // We'll manage features and checks in the UI & API.
  @@map("role")
}

model User {
  id            String       @id
  name          String
  email         String
  emailVerified Boolean      @default(false)
  image         String?
  // Guest (email-free) accounts. Null for normal email users. See guest-auth.ts.
  username        String?    @unique
  displayUsername String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  sessions      Session[]
  accounts      Account[]
  members       Member[]
  invitations   Invitation[]
  joinRequests  JoinRequest[]
  initiatedScanBatches AssetScanBatch[] @relation("AssetScanBatchInitiator")
  updatedPortDiscoveryConfigs OrganizationPortDiscoveryConfig[] @relation("OrganizationPortDiscoveryConfigUpdater")
  createdScanSchedules ScanSchedule[] @relation("ScanScheduleCreator")

  @@unique([email])
  @@map("user")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Organization {
  id          String       @id
  name        String
  slug        String
  logo        String?
  createdAt   DateTime
  metadata    String?
  isPublic    Boolean      @default(false)
  discoverable Boolean     @default(false)
  members      Member[]
  invitations  Invitation[]
  roles        Role[]
  assets       Asset[]
  assetScanBatches AssetScanBatch[]
  scanSchedules ScanSchedule[]
  scanScheduleRuns ScanScheduleRun[]
  portDiscoveryConfig OrganizationPortDiscoveryConfig?
  nmapAssets   NmapAsset[]
  joinRequests JoinRequest[]

  @@unique([slug])
  @@map("organization")
}

model Member {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member")
  createdAt      DateTime

  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

model LoginCode {
  id        String   @id @default(cuid())
  email     String
  code      String
  token     String   @db.Text
  url       String   @db.Text
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email, code])
  @@map("login_code")
}

model JoinRequest {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  status         String       @default("pending") // pending, accepted, denied
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([userId])
  @@map("join_request")
}

model Asset {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  value          String
  type           String       @default("domain") // "domain" or "ip"
  isRoot         Boolean      @default(true)
  parentId       String?
  parent         Asset?       @relation("AssetHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children       Asset[]      @relation("AssetHierarchy")
  verified       Boolean      @default(false)
  resolvedIp     String?      // The resolved IP address for domain/subdomain assets
  openPorts      String?      // JSON string array of { number, protocol } open ports; defaults to [{ number: 443, protocol: "tcp" }] until discovery runs
  bucket         String       @default("General")
  scanStatus     String       @default("idle") // idle, scanning, failed
  lastScanDate   DateTime?
  portDiscoveryStatus String  @default("idle") // idle, scanning, completed, expired, failed
  lastPortDiscoveryDate DateTime?
  scans          AssetScan[]
  createdAt      DateTime     @default(now())

  @@unique([organizationId, value])
  @@index([organizationId])
  @@map("asset")
}

model AssetScan {
  id          String   @id @default(cuid())
  assetId     String
  asset       Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  batchId     String?
  batch       AssetScanBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  type        String   @default("openssl") // The type of TLS scan
  portNumber  Int?
  portProtocol String?
  status      String   @default("pending") // pending, running, completed, failed
  resultData  String?  // JSON text representation of the scanner output
  createdAt   DateTime @default(now())
  completedAt DateTime?

  @@index([assetId])
  @@index([batchId])
  @@index([assetId, portNumber, portProtocol])
  @@map("asset_scan")
}

model AssetScanBatch {
  id                String       @id @default(cuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  initiatedByUserId String
  initiatedBy       User         @relation("AssetScanBatchInitiator", fields: [initiatedByUserId], references: [id], onDelete: Cascade)
  engine            String       @default("openssl") // openssl, portDiscovery
  type              String       // single, group, full
  status            String       @default("queued") // queued, running, completed, failed
  configSnapshot    String?
  totalAssets       Int          @default(0)
  completedAssets   Int          @default(0)
  failedAssets      Int          @default(0)
  createdAt         DateTime     @default(now())
  startedAt         DateTime?
  completedAt       DateTime?
  scans             AssetScan[]

  @@index([organizationId, status])
  @@index([initiatedByUserId])
  @@map("asset_scan_batch")
}

model OrganizationPortDiscoveryConfig {
  id               String       @id @default(cuid())
  organizationId   String       @unique
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entries          String
  probeBatchSize   Int          @default(5)
  probeTimeoutMs   Int          @default(600)
  updatedByUserId  String?
  updatedBy        User?        @relation("OrganizationPortDiscoveryConfigUpdater", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@map("organization_port_discovery_config")
}

model ScanSchedule {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdByUserId String
  createdBy       User         @relation("ScanScheduleCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)
  engine          String
  type            String
  mode            String
  frequency       String?
  interval        Int?
  runAt           DateTime
  nextRunAt       DateTime?
  assetIds        String
  configSnapshot  String?
  enabled         Boolean      @default(true)
  timezone        String?
  lastRunAt       DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  runs            ScanScheduleRun[]

  @@index([organizationId, enabled, nextRunAt])
  @@index([createdByUserId])
  @@map("org_scan_schedule")
}

model ScanScheduleRun {
  id            String       @id @default(cuid())
  scheduleId    String
  schedule      ScanSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  organizationId String
  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  status        String       @default("pending")
  dueAt         DateTime
  queuedBatchId String?
  error         String?
  createdAt     DateTime     @default(now())
  startedAt     DateTime?
  completedAt   DateTime?

  @@index([organizationId, status, dueAt])
  @@index([scheduleId, dueAt])
  @@map("org_scan_schedule_run")
}

model NmapAsset {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  target         String       // The domain or IP added by the user
  resolvedIp     String?      // The resolved IP address populated after scanning
  scanStatus     String       @default("idle") // idle, scanning, completed, failed
  lastScanDate   DateTime?
  scans          NmapAssetScan[]
  createdAt      DateTime     @default(now())

  @@unique([organizationId, target])
  @@index([organizationId])
  @@map("nmap_asset")
}

model NmapAssetScan {
  id          String   @id @default(cuid())
  assetId     String
  asset       NmapAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  status      String   @default("pending") // pending, completed, failed
  resultData  String?  // JSON text payload from the nmap API response
  createdAt   DateTime @default(now())
  completedAt DateTime?

  @@index([assetId])
  @@map("nmap_asset_scan")
}
